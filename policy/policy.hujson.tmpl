// Tailnet policy — SOURCE OF TRUTH.
//
// This file is a TEMPLATE. Render it with scripts/render-policy.py before
// applying; the rendered output is gitignored because it contains real
// addresses. Never edit the rendered file — edits go here.
//
// Placeholders are the only real-world values the policy needs. Everything
// else is expressed in roles, which is the point: a tag is a role in the
// system, and roles are what the model is about.
{
	// ------------------------------------------------------------------
	// Tag taxonomy. Declaring a tag makes it usable; it grants nothing.
	// ------------------------------------------------------------------
	// Owned by autogroup:admin rather than a named identity, so the taxonomy
	// survives a change of account.
	"tagOwners": {
		// Held by a real device:
		"tag:prod":         ["autogroup:admin"], // production server stand-in
		"tag:gateway-home": ["autogroup:admin"], // subnet router for the IoT segment
		"tag:appliance":    ["autogroup:admin"], // attached to the network, originates nothing

		// The collector is a live node: a container on the cloud dev host
		// (D-048). The other two are declared but UNHOMED -- filled by units
		// the fleet scripts create in later phases. Saying so avoids implying
		// a fleet exists.
		"tag:collector": ["autogroup:admin"], // telemetry sink, outside the house
		"tag:sensor":    ["autogroup:admin"], // simulated sensors: push-only telemetry
		"tag:drone":     ["autogroup:admin"], // simulated mobile units: telemetry AND control
	},

	// ------------------------------------------------------------------
	// Device posture
	// ------------------------------------------------------------------
	// Built only from attributes the client reports about itself -- no MDM or
	// EDR integration, which is what a paid plan adds.
	//
	// The handoff states posture is unavailable on this plan and gates a whole
	// phase on that. It is wrong: these are evaluated and enforced here, proven
	// by the assertions below changing outcome when the attributes change.
	"postures": {
		// Enough to be trusted with changing physical state: the client keeps
		// its own state encrypted at rest, and runs a released build rather
		// than an unstable one.
		"posture:trustedOperator": [
			"node:tsStateEncrypted == true",
			"node:tsReleaseTrack == 'stable'",
		],
	},

	// ------------------------------------------------------------------
	// Hosts behind the gateway. The ONLY real values in the policy.
	// ------------------------------------------------------------------
	// These are devices that cannot run a client. They are reachable only
	// through the gateway, one host route each -- never a subnet.
	//
	// Naming them here means the grants and tests below read as roles rather
	// than as addresses, and it confines every templated value to two lines.
	//
	// An address is not an identity. There are no DHCP reservations on this
	// network and addresses have moved between devices, so each entry here is
	// re-verified by the device's own identifier, not assumed (D-047). A camera
	// was removed from this block for exactly that reason.
	"hosts": {
		"actuator-granted": "{{actuator_granted}}",
		"actuator-control": "{{actuator_control}}",
	},

	// ------------------------------------------------------------------
	// Grants. Deny-by-default: anything not written here is refused.
	// Every grant names a port. There is no `*` anywhere in this section.
	// ------------------------------------------------------------------
	"grants": [
		// --- The household guarantee -------------------------------------
		// Remote access to the automation UI is the entire blast radius of
		// this project. It is the first grant in the file and it carries an
		// accept assertion below. If a later change breaks it, the build
		// fails rather than someone's evening.
		{
			"src": ["autogroup:member"],
			"dst": ["tag:gateway-home"],
			"ip":  ["tcp:8123"],
		},

		// --- The household's own recovery path: SSH between its devices ---
		// Before this policy the tailnet allowed everything, and the house
		// relied on that without writing it down: SSH from the owner's laptop
		// to the home server carries its duty timers, the recorder tunnel and
		// the laptop's remote wake. Phase 2 dropped it and no test noticed
		// (D-051). `autogroup:self` is each person's own devices, so this
		// reaches nothing a member does not already own, and no tagged node.

		// --- Operator to the production stand-in --------------------------
		// Phase 4 replaces this with a time-boxed grant. Until then it is a
		// standing one, which is exactly the thing JIT is meant to remove.
		{
			"src": ["autogroup:member"],
			"dst": ["tag:prod"],
			"ip":  ["tcp:22"],
		},

		// --- Telemetry tier: the hub pushes out ---------------------------
		// The machine that has the data sends it; nothing outside the house
		// needs a way in. The collector used to be granted the hub's broker;
		// that grant is gone, and the collector now reaches nothing inside
		// the home at all (D-049). The connection's tailnet identity is the
		// credential: this port is reachable only from the roles named here.
		{
			"src": ["tag:gateway-home"],
			"dst": ["tag:collector"],
			"ip":  ["tcp:8443"],
		},

		// --- Telemetry tier: field units report in ------------------------
		// Push-only. Sensors originate a stream and nothing else.
		{
			"src": ["tag:sensor", "tag:drone"],
			"dst": ["tag:collector"],
			"ip":  ["tcp:8443"],
		},

		// --- Stream tier: withdrawn ---------------------------------------
		// A camera was exposed here by address. The address turned out to
		// belong to a camera the owner had not released for the lab, identified
		// in the first place by a DHCP name two cameras share. The route and
		// this grant are gone (D-047). The one camera that is released comes
		// back through a restream named by camera, not by a /32 to an address
		// that can change hands.

		// --- Action tier: ONE actuator, not the class ---------------------
		// The granted unit and the control unit are the same model on the
		// same port behind the same gateway. Only one is named. That is what
		// makes the assertion below a demonstration rather than a claim.
		//
		// Phase 4 makes this time-boxed. The padding below is readability
		// only. It is safe to rely on: the control plane stores this file
		// verbatim and reformats nothing, which was tested by saving a
		// render and reading it back byte-identical. That is what makes
		// hashing the live file against the render a usable integrity check.
		{
			"src":        ["autogroup:member"],
			"dst":        ["actuator-granted"],
			"ip":         ["tcp:52432"],
			"via":        ["tag:gateway-home"],
			"srcPosture": ["posture:trustedOperator"],
		},

		// --- Control channel to mobile units ------------------------------
		// The distinction that makes a drone not a sensor: it can be
		// commanded. This is the grant Phase 4 exists to constrain.
		{
			"src": ["autogroup:member"],
			"dst": ["tag:drone"],
			"ip":  ["tcp:8444"],
		},

		// NOTE what is absent, deliberately:
		//   - tag:appliance appears in no `src`. It originates nothing.
		//   - "actuator-control" appears in no grant at all.
		//   - No grant reaches the site gateway's administration interface.
		//   - No grant is wider than a single port.
	],

	// ------------------------------------------------------------------
	// Tailscale SSH
	// ------------------------------------------------------------------
	// The baseline allowed check-mode SSH to autogroup:self as root. Tagging
	// the infrastructure removed those nodes from `self`, so this restates it
	// narrowly: members may reach the production stand-in, in check mode.
	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["tag:prod"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// ------------------------------------------------------------------
	// Tests. THE DELIVERABLE OF THIS PHASE.
	// ------------------------------------------------------------------
	// These run on every save; a failing assertion causes the tailnet to
	// reject the file. The `deny` entries carry most of the value: an
	// `accept` regression announces itself when someone's connection breaks,
	// a silent privilege expansion does not.
	"tests": [
		// The household guarantee, asserted. This is the one that must never
		// regress, and the reason it is first.
		{
			// The grant above says autogroup:member; the test must name a
			// concrete principal. Tailscale accepts the autogroup in a grant
			// and rejects it here -- "unknown user or host" -- so the identity
			// is templated like the addresses rather than committed.
			"src":    "{{operator_identity}}",
			"accept": ["tag:gateway-home:8123"],
			"deny":   ["tag:gateway-home:1883", "tag:gateway-home:22"],
		},

		// The household's SSH between its own devices, asserted: a user as
		// the destination means that user's devices.
		{
			"src":    "{{operator_identity}}",
			"accept": ["{{operator_identity}}:22"],
		},

		// The only way into the production stand-in. Its SSH port is closed
		// to the internet (D-042), so a change that dropped this grant would
		// lock the operator out of the machine two projects run on. The build
		// fails first.
		{
			"src":    "{{operator_identity}}",
			"accept": ["tag:prod:22"],
		},

		// Action tier, asserted on two axes at once.
		//
		// Per HOST: two identical devices, same model, same port, behind the
		// same gateway -- one named in a grant, one not. Least privilege here
		// is per host, not per protocol.
		//
		// Per DEVICE STATE: the same person, the same socket, the same port --
		// and the only difference is what the device reports about itself.
		{
			"src": "{{operator_identity}}",
			"srcPostureAttrs": {
				"node:tsStateEncrypted": true,
				"node:tsReleaseTrack":   "stable",
			},
			"accept": ["actuator-granted:52432"],
			"deny":   ["actuator-control:52432"],
		},

		// The two blocks below fail one attribute each, holding the other at
		// the passing value. Failing both at once would also produce a Drop and
		// would prove less: it could not tell which attribute is carrying the
		// decision, or whether either is.
		{
			// Same person, released build -- but unencrypted state at rest.
			"src": "{{operator_identity}}",
			"srcPostureAttrs": {
				"node:tsStateEncrypted": false,
				"node:tsReleaseTrack":   "stable",
			},
			"deny": ["actuator-granted:52432"],
		},

		{
			// Same person, encrypted state -- but an unstable client build.
			"src": "{{operator_identity}}",
			"srcPostureAttrs": {
				"node:tsStateEncrypted": true,
				"node:tsReleaseTrack":   "unstable",
			},
			"deny": ["actuator-granted:52432"],
		},

		// Sensors are push-only and reach exactly one port on one role.
		{
			"src":    "tag:sensor",
			"accept": ["tag:collector:8443"],
			"deny": [
				"tag:prod:22", // cannot reach production
				"tag:collector:22", // cannot administer its own sink
				"tag:sensor:8443", // cannot reach a peer sensor
				"tag:gateway-home:1883", // cannot talk to the broker directly
				"tag:gateway-home:8123", // cannot reach the automation UI
				"actuator-granted:52432", // cannot change physical state
			],
		},

		// The appliance originates nothing. Its tag says so; this proves it.
		{
			"src": "tag:appliance",
			"deny": [
				"tag:gateway-home:8123",
				"tag:gateway-home:1883",
				"tag:prod:22",
				"tag:collector:8443",
				"actuator-granted:52432",
				"actuator-control:52432",
			],
		},

		// The collector lives outside the house and reaches nothing inside
		// it -- not the broker, not the UI, not an actuator, ever.
		{
			"src": "tag:collector",
			"deny": [
				"tag:gateway-home:8443", // the push port, the other way: refused
				"tag:gateway-home:1883", // it is pushed to; it does not pull
				"tag:gateway-home:8123",
				"tag:gateway-home:22",
				"actuator-granted:52432",
				"actuator-control:52432",
				"tag:prod:22",
			],
		},

		// The hub may deliver telemetry to the collector, and do nothing
		// else to it -- delivering data is not administering the machine.
		{
			"src":    "tag:gateway-home",
			"accept": ["tag:collector:8443"],
			"deny":   ["tag:collector:22", "tag:prod:22"],
		},

		// Drones report like sensors. Being commandable does not make them
		// privileged.
		{
			"src":    "tag:drone",
			"accept": ["tag:collector:8443"],
			"deny":   ["tag:prod:22", "tag:gateway-home:1883", "actuator-granted:52432"],
		},

		// Production is a destination, not a source. A compromised prod host
		// must not become a route into the home.
		{
			"src": "tag:prod",
			"deny": [
				"tag:gateway-home:8123",
				"actuator-granted:52432",
			],
		},
	],
}
