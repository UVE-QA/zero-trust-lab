# Every real value lives in local/ and never leaves this machine.
# The one exception is the schema example, which carries only placeholders.
local/*
!local/inventory.example.yaml

# Rendered policy: contains real addresses. The template is the source.
policy/.rendered/

*.tfstate*
# Terraform: state holds secrets in plaintext, tfvars holds the account id.
terraform.tfvars
backend.hcl
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl

# Plan files and apply logs contain the account id in full. They are working
# artefacts, not deliverables -- and this is the class of file the sweep cannot
# help with, because it only sees what is tracked.
*.tfplan
tfplan.bin
apply.log

*.pem
*.key
.env
.DS_Store
